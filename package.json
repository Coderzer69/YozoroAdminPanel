{
  "name": "yozora-anime-player",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "A local anime library player for personal video files and authorized direct/HLS streams.",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --experimental-strip-types server.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3"
  }
}
